{
  "schema_version": "1.2.0",
  "decision_id": "phase4.financial_reference.source_policy",
  "status": "migrated_boundary_hardened_and_A05_resolved",
  "as_of": "2026-09-13",
  "domain": "financial_reference",
  "canonical_inputs": {
    "selic": {
      "source_id": "BCB_SELIC_META_SGS_432",
      "series_code": 432,
      "input_semantic": "selic_meta_percent_per_year",
      "artifact_semantic": "annual_percent_rate",
      "transformation": "identity"
    },
    "cdi": {
      "source_id": "BCB_CDI_DAILY_SGS_12",
      "series_code": 12,
      "input_semantic": "cdi_percent_per_business_day",
      "artifact_semantic": "annual_percent_rate",
      "transformation": "((1 + daily_rate_pct / 100) ^ 252 - 1) * 100",
      "rounding": "ROUND_HALF_UP_2_DECIMALS"
    }
  },
  "freshness_policy": {
    "selic_meta": {
      "semantics": "persistent_until_changed",
      "max_observation_age_calendar_days": null,
      "future_observation_allowed": false,
      "reason": "SGS 432 represents the latest policy-rate observation and can remain current between Copom changes."
    },
    "cdi_daily": {
      "semantics": "daily_business_day_observation",
      "max_observation_age_calendar_days": 7,
      "future_observation_allowed": false,
      "reason": "Phase 4 does not embed a Brazilian holiday calendar; seven calendar days tolerate weekends/ordinary holiday gaps while preventing stale daily data from being relabelled by a new generated_at_utc."
    }
  },
  "b3_role": {
    "benchmark_administrator_and_methodology_authority": true,
    "legacy_ftp_is_automatic_fallback": false,
    "legacy_ftp_is_production_input_after_migration": false,
    "use": "human_corroboration_and_methodology_reference"
  },
  "failure_policy": {
    "require_current_parsed_candidate_for_new_artifact": true,
    "if_any_source_fails": "do_not_rewrite_taxas_bacen_json",
    "persist_operational_failure_state": true,
    "preserve_existing_artifact_bytes": true,
    "write_static_fallback": false,
    "refresh_generated_at_without_new_observation": false,
    "parser_incompatible_last_good": {
      "policy_id": "preserve_auditable_block_new_consumption",
      "preserve_previous_snapshot_candidate_and_artifact": true,
      "allow_audit_of_preserved_last_good": true,
      "allow_new_taxas_artifact_generation": false,
      "allow_new_dados_fiscais_composition": false,
      "allow_generated_at_refresh": false,
      "allow_value_relabel_as_current": false,
      "resume_condition": "a current collection must again produce PARSED with valid evidence",
      "reason": "A successful fetch followed by PARSER_INCOMPATIBLE is evidence that the source format changed. Reusing the old candidate in a newly generated artifact would hide that incompatibility and falsely imply current parsing success."
    }
  },
  "consumer_boundary": {
    "scraper_may_consume_only_local_artifact": true,
    "required_schema_version": "1.4.0",
    "required_cdi_basis": "bcb_sgs_12_daily_compounded_252",
    "required_source_ids": [
      "BCB_SELIC_META_SGS_432",
      "BCB_CDI_DAILY_SGS_12"
    ],
    "financial_evidence_must_validate_before_payroll_consumption": true,
    "current_parser_incompatible_blocks_new_consumption": true,
    "preserved_last_good_is_audit_only_until_parser_recovers": true,
    "remote_raw_github_fallback_allowed": false,
    "arbitrary_url_override_allowed": false
  },
  "persistence": {
    "runtime_root": "evidence/source-runtime-v1",
    "snapshots": "retain_all_unique_sha256",
    "candidates": "retain_all_unique_sha256",
    "state": "latest_materialized_state_plus_git_history",
    "artifact_and_evidence_same_commit_on_success": true
  },
  "scope_boundary": {
    "financial_reference_is_not_legal_rule_authority": true,
    "semantic_diff": "phase5",
    "consumer_migration": "phase6"
  }
}
